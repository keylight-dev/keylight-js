{
  "name": "@keylight-dev/js",
  "version": "0.1.5",
  "description": "Official JavaScript/TypeScript SDK for Keylight licensing.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keylight-dev/keylight-js.git"
  },
  "homepage": "https://docs.keylight.dev/js-sdk/install/",
  "bugs": {
    "url": "https://github.com/keylight-dev/keylight-js/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "KEYLIGHT_LIVE=1 vitest run tests/live_integration.test.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
